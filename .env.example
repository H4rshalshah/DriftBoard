NODE_ENV=development
PORT=5000

# Render backend
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/driftboard?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:3000
ALLOW_VERCEL_PREVIEWS=false
MAX_UPLOAD_FILE_SIZE_MB=10
SUPPORTED_UPLOAD_EXTENSIONS=.py,.json,.yaml,.yml

# Email, set on Render only. SMTP works with Gmail App Password, SendGrid SMTP, Mailgun, etc.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-smtp-user
EMAIL_PASS=your-smtp-password-or-app-password
EMAIL_FROM=DriftBoard <support@example.com>
CONTACT_ADMIN_EMAIL=support@example.com
SUPPORT_EMAIL=support@example.com
ALERT_REPLY_TO=support@example.com
EMAIL_MOCK_MODE=false

# Optional Resend alternative. If set, Resend is tried before SMTP.
RESEND_API_KEY=
ALERT_FROM_EMAIL=

# Vercel frontend
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
