# ============================================
# DriftBoard Production Environment Variables
# ============================================
# Copy this file and rename to .env for local dev,
# or use these keys in Render/Vercel dashboards.
# ============================================

# --- Core ---
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://driftboard-three.vercel.app
ALLOWED_ORIGINS=https://driftboard-three.vercel.app
PUBLIC_APP_URL=https://driftboard-three.vercel.app

# --- MongoDB (Atlas) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/driftboard?retryWrites=true&w=majority
PERSISTENCE_DRIVER=mongodb

# --- Redis (Upstash) ---
# Use rediss:// (TLS) for Upstash
REDIS_URL=rediss://default:<token>@<region>.upstash.io:33713

# --- JWT ---
JWT_SECRET=<generate-a-random-secret>
JWT_REFRESH_SECRET=<generate-another-random-secret>
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# --- Email (SMTP / Gmail) ---
EMAIL_MOCK_MODE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=h4rshal.workspace@gmail.com
SMTP_PASS=<gmail-app-password>
EMAIL_FROM=DriftBoard <h4rshal.workspace@gmail.com>
ALERT_FROM_EMAIL=h4rshal.workspace@gmail.com
ALERT_REPLY_TO=h4rshal.workspace@gmail.com
CONTACT_ADMIN_EMAIL=h4rshal.workspace@gmail.com

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=2000

# --- File Uploads ---
MAX_UPLOAD_FILE_SIZE_MB=10

# --- Misc ---
DATA_DIR=/tmp/driftboard-data
ALLOW_VERCEL_PREVIEWS=true
