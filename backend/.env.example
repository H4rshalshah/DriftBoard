# =========================================
# DRIFTBOARD ENV CONFIG
# =========================================

NODE_ENV=development
PORT=5000

# =========================================
# FRONTEND
# =========================================

FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

SOCKET_PORT=5001

# =========================================
# DATABASE
# =========================================

MONGODB_URI=mongodb://localhost:27017/driftboard

# =========================================
# REDIS
# =========================================

REDIS_HOST=localhost
REDIS_PORT=6379

# =========================================
# JWT AUTH
# =========================================

JWT_SECRET=driftboard-super-secret-jwt-key
JWT_REFRESH_SECRET=driftboard-refresh-secret-key

JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =========================================
# RATE LIMITING
# =========================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=2000

CONTACT_RATE_LIMIT_WINDOW_MS=900000
CONTACT_RATE_LIMIT_MAX_REQUESTS=5

# =========================================
# EMAIL / SMTP CONFIG
# =========================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

SMTP_USER=h4rshal.workspace@gmail.com
SMTP_PASS="mvmm cmsl xrgu ztwl"

EMAIL_FROM="DriftBoard <h4rshal.workspace@gmail.com>"

ALERT_FROM_EMAIL=h4rshal.workspace@gmail.com
ALERT_REPLY_TO=h4rshal.workspace@gmail.com

CONTACT_ADMIN_EMAIL=h4rshal.workspace@gmail.com

EMAIL_MOCK_MODE=false

TEST_EMAIL_WINDOW_MS=600000
TEST_EMAIL_MAX_REQUESTS=3

# =========================================
# OPTIONAL OAUTH
# =========================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
